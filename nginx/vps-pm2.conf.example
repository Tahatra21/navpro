# NAVPRO — contoh snippet Nginx untuk VPS (PM2: frontend :3000, backend :4000)
# Salin ke /etc/nginx/sites-available/navpro lalu sesuaikan server_name & SSL.

map $request $navpro_absolute_uri {
  default 0;
  ~*^[A-Z]+\s+https?:// 1;
}

server {
  listen 443 ssl http2;
  server_name maharyuda.my.id;

  ssl_certificate     /path/to/fullchain.pem;
  ssl_certificate_key /path/to/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  server_tokens off;
  http2_max_concurrent_streams 128;

  if ($navpro_absolute_uri) { return 400; }

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location = /api/v1/auth/login {
    limit_req zone=navpro_login burst=3 nodelay;
    if ($request_method = OPTIONS) { return 405; }
    proxy_pass http://127.0.0.1:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    if ($request_method = OPTIONS) { return 405; }
    proxy_pass http://127.0.0.1:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    if ($request_method = OPTIONS) { return 405; }
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# Di http {} block:
# limit_req_zone $binary_remote_addr zone=navpro_login:10m rate=5r/m;
